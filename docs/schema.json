{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yangchen-cn.github.io/CardPilot-Catalog/schema.json",
  "title": "CardPilot public catalog snapshot V2",
  "description": "Official banks, products, offers and public artwork, plus optional agent-authored usage guidance based on official terms. Never contains personal data. Artwork paths are relative to the catalog root and verified by SHA-256.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contentVersion",
    "publishedAt",
    "banks",
    "products"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "contentVersion": {
      "type": "integer",
      "minimum": 1
    },
    "publishedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/product"
      }
    },
    "banks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/bank"
      }
    }
  },
  "$defs": {
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "bankID",
        "artwork",
        "baseRewardVerified",
        "welcomePlans",
        "catalog"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "bankID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "baseRewardVerified": {
          "type": "boolean"
        },
        "welcomePlans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/welcomePlan"
          }
        },
        "catalog": {
          "$ref": "#/$defs/catalog"
        },
        "artwork": {
          "anyOf": [
            {
              "$ref": "#/$defs/asset"
            },
            {
              "type": "null"
            }
          ]
        },
        "searchTerms": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "usageGuide": {
          "anyOf": [
            {
              "$ref": "#/$defs/usageGuide"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "bank",
        "name",
        "network",
        "sourceURL",
        "verifiedOn",
        "rules"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "bank": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "network": {
          "type": "string"
        },
        "sourceURL": {
          "type": "string",
          "pattern": "^https://"
        },
        "verifiedOn": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "kind": {
          "type": "string"
        },
        "baseRatePercent": {
          "type": "number"
        },
        "foreignFeePercent": {
          "type": "number"
        },
        "overseasHKDFeePercent": {
          "type": "number"
        },
        "excludesWallets": {
          "type": "boolean"
        },
        "annualFeeNote": {
          "type": "string"
        },
        "caveats": {
          "type": "string"
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          }
        },
        "calculation": {
          "type": "object"
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "group",
        "sourceURL"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "cashback",
            "welcome"
          ]
        },
        "group": {
          "enum": [
            "daily",
            "limited",
            "merchant",
            "welcome"
          ]
        },
        "startsOn": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "endsOn": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "sourceURL": {
          "type": "string",
          "pattern": "^https://"
        },
        "ratePercent": {
          "type": "number"
        },
        "capHKD": {
          "type": "number"
        },
        "capPeriod": {
          "type": "string"
        },
        "sharedCapGroup": {
          "type": "string"
        },
        "thresholdHKD": {
          "type": "number"
        },
        "bonusHKD": {
          "type": "number"
        },
        "minimumHKD": {
          "type": "number"
        },
        "monthlyPhysicalThresholdHKD": {
          "type": "number"
        },
        "channelCondition": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "currency": {
          "type": "string"
        },
        "paymentMethod": {
          "type": "string",
          "enum": [
            "待确认",
            "Apple Pay",
            "实体卡",
            "网上支付",
            "支付宝",
            "微信支付",
            "UnionPay",
            "BoC Pay",
            "Huawei Pay",
            "PayMe",
            ""
          ],
          "description": "Use the canonical UnionPay label; UnionPay App and 云闪付 are aliases accepted by the client but not published."
        },
        "merchantKeywords": {
          "type": "string",
          "description": "Comma-separated merchant names/keywords, matching the Swift CatalogRule String field; not an array."
        },
        "requiresPersonalDates": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        },
        "calculation": {
          "type": "object"
        }
      }
    },
    "welcomePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "details",
        "sourceURL",
        "ruleIDs",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "details": {
          "type": "string"
        },
        "sourceURL": {
          "type": "string",
          "pattern": "^https://"
        },
        "ruleIDs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "applicationChannels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verified": {
          "type": "boolean"
        },
        "calculable": {
          "type": "boolean"
        },
        "periodType": {
          "type": "string"
        },
        "periodCount": {
          "type": "integer"
        },
        "applicationStartsOn": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "applicationEndsOn": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "kind": {
          "enum": [
            "main",
            "addon"
          ]
        },
        "exclusionGroup": {
          "type": "string"
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "contentType"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "^images/(banks|cards)/[A-Za-z0-9._/-]+$",
          "allOf": [
            {
              "not": {
                "pattern": "(^|/)\\.\\.(/|$)"
              }
            },
            {
              "not": {
                "pattern": "//"
              }
            }
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "contentType": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/webp"
          ]
        }
      }
    },
    "bank": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "shortName",
        "logo"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "shortName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "logo": {
          "anyOf": [
            {
              "$ref": "#/$defs/asset"
            },
            {
              "type": "null"
            }
          ]
        },
        "searchTerms": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        }
      }
    },
    "usageGuide": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional agent-authored reading material based on official terms; never a calculation policy.",
      "required": [
        "summary",
        "reviewedOn",
        "scenarios"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 480,
          "pattern": "\\S"
        },
        "reviewedOn": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "format": "date"
        },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/usageScenario"
          }
        }
      }
    },
    "usageScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "whenToUse",
        "howToUse",
        "relatedOfferIDs",
        "sourceURLs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "\\S"
        },
        "whenToUse": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "\\S"
        },
        "howToUse": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200,
          "pattern": "\\S"
        },
        "capNote": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 400,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "stopAfter": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 400,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "warnings": {
          "anyOf": [
            {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400,
                "pattern": "\\S"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "relatedOfferIDs": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "IDs of this product catalog.rules or welcomePlans. May be empty for product-level advice."
        },
        "sourceURLs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 2048,
            "pattern": "^https://",
            "format": "uri"
          }
        },
        "startsOn": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "endsOn": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
